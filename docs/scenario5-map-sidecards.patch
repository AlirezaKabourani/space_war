diff --git a/src/ui/components/scenario/ScenarioFive.css b/src/ui/components/scenario/ScenarioFive.css
index e1b2a81..62d5ae7 100644
--- a/src/ui/components/scenario/ScenarioFive.css
+++ b/src/ui/components/scenario/ScenarioFive.css
@@ -459,3 +459,21 @@
   .s5-last-decision { height: auto; grid-template-columns: 1fr; }
 }
 @media (max-width: 600px) { .s5-ending-alternatives { grid-template-columns: 1fr; } }
+
+/* Convoy information flanks the enlarged map; physical sides are explicit in RTL. */
+.s5-map-layout { display: grid; direction: ltr; grid-template-columns: clamp(120px,9.5vw,136px) minmax(0,1fr) clamp(120px,9.5vw,136px); grid-template-areas: "left map right"; gap: .45rem; min-width: 0; min-height: 0; }
+.s5-map-layout > .s5-map-frame { grid-area: map; }
+.s5-convoy-column { display: grid; direction: rtl; grid-template-rows: repeat(2,minmax(0,1fr)); gap: .45rem; min-width: 0; min-height: 0; }
+.s5-convoy-column-left { grid-area: left; }
+.s5-convoy-column-right { grid-area: right; }
+.s5-convoy-column .s5-convoy-mini { overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; padding: .5rem; }
+.s5-convoy-column .s5-convoy-mini header { position: sticky; top: -.5rem; padding-block: .2rem; background: #091a2b; z-index: 1; }
+.s5-convoy-column .s5-convoy-mini p { font-size: .72rem; }
+@media (min-width: 900px) {
+  .s5-workspace { grid-template-columns: minmax(360px,2fr) minmax(0,3fr); }
+  .s5-map-panel { grid-template-rows: 68px minmax(0,1fr); }
+}
+@media (max-width: 899px) {
+  .s5-map-panel { grid-template-rows: auto minmax(400px,1fr); }
+  .s5-map-layout { grid-template-columns: minmax(110px,.4fr) minmax(0,1fr) minmax(110px,.4fr); }
+}
