+  .s5-action-card { min-height: 0; }
+  .s5-primary-button, .s5-secondary-button { width: 100%; }
+}
+
+@media (max-width: 480px) {
+  .s5-root { padding-right: 4.5rem; padding-left: .55rem; }
 }
