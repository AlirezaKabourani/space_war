+    let f=el[Object.keys(el).find(k=>k.startsWith('__reactFiber'))];
+    while(f && f.type?.name!=='ScenarioFiveSimulation')f=f.return;
+    return f?.memoizedState?.memoizedState ?? null;
+  })()`);
