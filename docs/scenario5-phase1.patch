+                    { label: "منابع تا راندهای پایانی حفظ شوند", done: getResourceReserve(resources) >= 20, value: `ISR ${resources.satelliteISR} / ENG ${resources.energy} / TIME ${resources.time}` },
+                  ]).map((objective) => (
+                    <div key={objective.label} className={`s5-objective-row ${objective.done ? "done" : ""}`}>
+                      <b>{objective.done ? "✓" : "○"}</b>
+                      <span>{objective.label}</span>
+                      <strong>{objective.value}</strong>
+                    </div>
+                  ))}
+              </div>
+            )}
+            {openDrawer === "log" && (
+              <div className="s5-drawer-list">
+                {events.length === 0 && <p className="s5-empty-log">پس از اجرای تصمیم راند، پیامدها اینجا ثبت می‌شوند.</p>}
+                {events.map((event) => <div key={event.id} className={`s5-log-item ${event.level}`}>{event.text}</div>)}
+              </div>
+            )}
+          </aside>
+        </div>
+      )}
+
+      {roundOutcome && (
+        <div className="s5-outcome-backdrop">
+          <div className="s5-outcome-modal">
+            <h3>{roundOutcome.title}</h3>
+            <div>
+              {roundOutcome.messages.map((message) => (
+                <p key={message.text} className={message.level}>{message.text}</p>
+              ))}
+            </div>
+            <button className="primary" type="button" onClick={continueAfterOutcome}>ادامه به راند بعد</button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
