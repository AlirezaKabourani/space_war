--- /dev/null
+++ b/src/services/storage/cognitiveRunValidation.ts
@@ -0,0 +1,115 @@
+import type { CognitiveModelV3Result } from '../../ui/components/scenario/scenario-four/model/cognitiveEngineV3';
+import * as s1 from '../../ui/components/scenario/scenario-four/model/cognitiveOptionProfilesV3';
+import type { Scenario5CognitiveRunResult } from '../../ui/components/scenario/scenario-five/model/cognitive/types';
+import * as s2 from '../../ui/components/scenario/scenario-five/model/cognitive/versions';
+
+export type SavedCognitiveRunV1 = {
+  schemaVersion: 'cross-scenario-run-v1';
+  recordId: string;
+  userProfileId: string;
+  sourceRunId: string;
+  recordedAtIso: string;
+  source: 'new-completion-v1';
+  modelStamps: Record<string, string>;
+} & (
+  { releasedScenarioId: 4; internalScenarioId: 's4_redesigned_scenario_one'; cognitive: CognitiveModelV3Result } |
+  { releasedScenarioId: 5; internalScenarioId: 's5_silent_waves_redesign'; cognitive: Scenario5CognitiveRunResult }
+);
+
+type Check = (value: unknown, path: string) => void;
+const fail = (path: string): never => { throw new Error(`Invalid cognitive archive field: ${path}`); };
+const obj = (v: unknown, p: string): Record<string, unknown> => {
+  if (!v || typeof v !== 'object' || Array.isArray(v) || Object.getPrototypeOf(v) !== Object.prototype) return fail(p);
+  return v as Record<string, unknown>;
+};
+const text: Check = (v, p) => { if (typeof v !== 'string' || !v.trim()) fail(p); };
+const bool: Check = (v, p) => { if (typeof v !== 'boolean') fail(p); };
+const num = (min: number, max = Infinity): Check => (v, p) => {
+  if (typeof v !== 'number' || !Number.isFinite(v) || v < min - 1e-9 || v > max + 1e-9) fail(p);
+};
+const integer: Check = (v, p) => { num(0)(v, p); if (!Number.isInteger(v)) fail(p); };
+const literal = (expected: unknown): Check => (v, p) => { if (v !== expected) fail(p); };
+const nullable = (check: Check): Check => (v, p) => { if (v !== null) check(v, p); };
+const list = (check: Check): Check => (v, p) => {
+  if (!Array.isArray(v)) return fail(p);
+  v.forEach((x, i) => check(x, `${p}[${i}]`));
+};
+const shape = (required: Record<string, Check>, optional: Record<string, Check> = {}): Check => (v, p) => {
+  const record = obj(v, p);
+  for (const [key, check] of Object.entries(required)) check(record[key], `${p}.${key}`);
+  for (const [key, check] of Object.entries(optional)) if (Object.hasOwn(record, key) && record[key] !== undefined) check(record[key], `${p}.${key}`);
+  // Fail visibly on schema evolution; never strip unknown scientific fields.
+  for (const key of Object.keys(record)) if (!(key in required) && !(key in optional)) fail(`${p}.${key} (unknown)`);
+};
+const fields = (keys: string[], check: Check) => Object.fromEntries(keys.map(key => [key, check]));
+const percent = num(0, 100), signed = num(-1, 1), unit = num(0, 1), nonnegative = num(0);
+const npercent = nullable(percent), nsigned = nullable(signed), ntime = nullable(nonnegative);
+const iso: Check = (v, p) => { text(v, p); if (!Number.isFinite(Date.parse(v as string)) || new Date(v as string).toISOString() !== v) fail(p); };
+const uuid: Check = (v, p) => { if (typeof v !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(v)) fail(p); };
+const sourceId: Check = (v, p) => { text(v, p); if (/preview|fixture|demo|dummy|test.only|design.sample/i.test(v as string)) fail(p); };
+
+export const S1_STAMPS = {
+  measurementModelVersion: s1.COGNITIVE_MODEL_VERSION, formulaVersion: s1.COGNITIVE_FORMULA_VERSION,
+  optionProfileVersion: s1.OPTION_PROFILE_VERSION, scenarioContentVersion: s1.SCENARIO_CONTENT_VERSION,
+  expertPanelVersion: s1.EXPERT_PANEL_VERSION, anchorTestVersion: s1.ANCHOR_TEST_VERSION,
+};
+export const S2_STAMPS = {
+  measurementModelVersion: s2.S5_COGNITIVE_MEASUREMENT_MODEL_VERSION, formulaVersion: s2.S5_COGNITIVE_FORMULA_VERSION,
+  optionProfileVersion: s2.S5_OPTION_PROFILE_VERSION, scenarioContentVersion: s2.S5_SCENARIO_CONTENT_VERSION,
+  reasonModelVersion: s2.S5_REASON_MODEL_VERSION, expertPanelVersion: s2.S5_EXPERT_PANEL_VERSION,
+  validityStatus: s2.S5_VALIDITY_STATUS,
+};
+const stamps = (values: Record<string, string>) => shape(Object.fromEntries(Object.entries(values).map(([key, value]) => [key, literal(value)])));
+const constructKeys = ['informationSeeking', 'secondOrderThinking', 'adversaryModeling', 'escalationSensitivity', 'informationDiscipline', 'evidenceResponsiveUpdating', 'resourceStewardship', 'planningForesight', 'multiDomainIntegration', 'decisionCoherence'];
+const flagKeys = ['uniform_option_position', 'very_low_active_time', 'zero_evidence_engagement', 'invariant_attribution', 'minimal_revision', 'rapid_straightlining'];
+const resources = shape(fields(['ssaCapacity', 'protectiveCapacity', 'politicalCapital', 'disclosureBudget'], percent));
+const fullDecisionTime = shape({
+  runId: sourceId, moveId: (v, p) => { if (!['move_1', 'move_2', 'move_3'].includes(v as string)) fail(p); },
+  windowId: text, enteredAt: iso, confirmedAt: iso, elapsedMs: nonnegative, activeDecisionMs: nonnegative,
+  finalSelectedOptionId: text, optionChangeCount: integer, selectionTimeline: list(shape({ optionId: text, ts: iso })),
+  evidenceAvailableIds: list(text), evidenceOpenedIds: list(text),
+  evidenceOpenTimeline: list(shape({ evidenceId: text, sourceType: text, openedAt: iso }, { closedAt: iso, activeDwellMs: nonnegative })),
+  helpOpened: bool, glossaryOpened: bool, resourcesBefore: resources, resourcesAfterUserAction: resources,
+}, { firstSelectedOptionId: text, playerAttributionEstimateBefore: percent, playerAttributionEstimateAfter: percent,
+  systemAttributionConfidenceVisibleAtDecision: percent, statedReasonId: text, statedReasonText: text });
+const decisionTime: Check = (v, p) => {
+  // The engine currently returns full telemetry objects here although its public type is narrower.
+  if ('runId' in obj(v, p)) fullDecisionTime(v, p);
+  else shape({ windowId: text, activeDecisionMs: nonnegative })(v, p);
+};
+const summaryFields = { medianActiveDecisionMs: ntime, iqrActiveDecisionMs: ntime, totalRevisions: integer, revisedWindows: integer, evidenceTriggeredRevisionRate: npercent };
+const s1Cognitive = shape({
+  versions: stamps(S1_STAMPS),
+  orientation: shape({ overall: nsigned, markerPercent: npercent, perMove: shape(fields(['move1', 'move2', 'move3'], nsigned)), operationalStrength: npercent, strategicStrength: npercent, integration: npercent, dispersion: nullable(unit), dispersionLabel: text, interpretation: text }),
+  scores: shape({ ...fields([...constructKeys, 'coalitionOrientation'], npercent), riskPosture: nsigned }),
+  dataCompleteness: shape({ overall: percent, components: shape(fields(['coreDecisionRecords', 'timingIntegrity', 'evidenceTelemetry', 'attributionEstimates', 'reasonCapture'], percent)) }),
+  timing: shape({ ...summaryFields, totalEvidenceDwellMs: nonnegative, firstToFinalChanges: list(shape({ windowId: text, final: text }, { first: text })) }, { longestDecision: decisionTime, shortestDecision: decisionTime }),
+  attribution: shape({ evidenceAlignment: list(shape({ phase: text, score: percent })), meanEvidenceAlignment: npercent, evidenceUpdatingAudit: list(shape({ phaseBefore: text, phaseAfter: text, ...fields(['playerBefore', 'playerAfter', 'evidenceBefore', 'evidenceAfter', 'finalContribution'], percent), dP: signed, dE: signed, ...fields(['directionAgreement', 'magnitudeAlignment', 'weight', 'rawScore'], unit) })) }),
+  responseProcess: shape({ flags: shape(fields(flagKeys, bool)), activeFlags: list((v, p) => { if (!flagKeys.includes(v as string)) fail(p); }), status: (v, p) => { if (v !== 'normal' && v !== 'caution') fail(p); } }),
+  perWindow: list(shape({ windowId: text, optionId: text, adjustedOsi: nsigned, operationalLoading: nonnegative, strategicLoading: nonnegative, diagnosticWeight: nonnegative, evidenceCoverage: nullable(unit) })),
+  missingReasons: list(text),
+});
+const s2Cognitive = shape({
+  ...Object.fromEntries(Object.entries(S2_STAMPS).map(([key, value]) => [key, literal(value)])),
+  scenarioId: literal('s5_silent_waves_redesign'), runId: sourceId,
+  orientation: shape({ overall: nsigned, operationalStrength: npercent, strategicStrength: npercent, integration: npercent, dispersion: nullable(unit), phaseScores: (v, p) => { list(nsigned)(v, p); if ((v as unknown[]).length !== 4) fail(p); } }),
+  constructs: shape({ ...fields(constructKeys, npercent), informationDiscipline: literal(null), riskPosture: nsigned }),
+  dataCompleteness: shape(fields(['overall', 'decisions', 'timing', 'evidence', 'estimates', 'reasons'], percent)),
+  telemetrySummary: shape(summaryFields),
+});
+
+export function validateSavedCognitiveRun(value: unknown): asserts value is SavedCognitiveRunV1 {
+  const row = obj(value, 'record');
+  if (row.releasedScenarioId !== 4 && row.releasedScenarioId !== 5) fail('releasedScenarioId');
+  const isS1 = row.releasedScenarioId === 4;
+  shape({ schemaVersion: literal('cross-scenario-run-v1'), recordId: uuid, userProfileId: text,
+    releasedScenarioId: literal(isS1 ? 4 : 5), internalScenarioId: literal(isS1 ? 's4_redesigned_scenario_one' : 's5_silent_waves_redesign'),
+    sourceRunId: sourceId, recordedAtIso: iso, source: literal('new-completion-v1'), modelStamps: stamps(isS1 ? S1_STAMPS : S2_STAMPS), cognitive: isS1 ? s1Cognitive : s2Cognitive,
+  })(value, 'record');
+  if (!isS1 && obj(row.cognitive, 'cognitive').runId !== row.sourceRunId) fail('sourceRunId mismatch');
+  if (isS1) {
+    const windows = (row.cognitive as CognitiveModelV3Result).perWindow.map(x => x.windowId);
+    const expected = Object.keys(s1.COGNITIVE_WINDOWS_V3);
+    if (windows.length !== expected.length || new Set(windows).size !== expected.length || windows.some(w => !expected.includes(w))) fail('incomplete S1 core windows');
+  }
+}
diff --git a/src/services/storage/cognitiveRunRepository.ts b/src/services/storage/cognitiveRunRepository.ts
--- /dev/null
+++ b/src/services/storage/cognitiveRunRepository.ts
@@ -0,0 +1,142 @@
+import { loadProfileState } from './profileStorage';
+import { readCognitiveArchivePolicy } from './cognitiveArchivePolicy';
+import { validateSavedCognitiveRun, type SavedCognitiveRunV1 } from './cognitiveRunValidation';
+
+export const COGNITIVE_ARCHIVE_DB = 'space-war.completed-cognitive-runs.v1';
+export const COGNITIVE_ARCHIVE_STORE = 'completedRuns';
+export class CognitiveStorageError extends Error {
+  readonly code: string;
+  constructor(code: string, message: string) { super(message); this.name = 'CognitiveStorageError'; this.code = code; }
+}
+const storageFailure = (error: unknown) => error instanceof CognitiveStorageError ? error : new CognitiveStorageError(
+  error instanceof DOMException ? error.name : 'StorageError',
+  `ذخیره/خواندن آرشیو شناختی ناموفق بود (${error instanceof Error ? error.message : String(error)}).`,
+);
+
+export function requireExistingCognitiveOwner(profileId: string): void {
+  // This is an interface-level profile check, not authenticated authorization.
+  if (typeof profileId !== 'string' || !profileId.trim() || !loadProfileState(3).profiles.some(p => p.id === profileId)) {
+    throw new CognitiveStorageError('OwnerMissing', 'پروفایل معتبر آغازکننده در دسترس نیست؛ گزارش ذخیره نشد.');
+  }
+  // Detect unavailable localStorage rather than accepting the profile loader's fallback on an exception.
+  localStorage.getItem('space-war.profiles.v1');
+}
+
+async function openArchive(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    try {
+      if (typeof indexedDB === 'undefined') throw new CognitiveStorageError('Unavailable', 'IndexedDB در این مرورگر در دسترس نیست.');
+      const request = indexedDB.open(COGNITIVE_ARCHIVE_DB, 1);
+      let finished = false;
+      const timer = setTimeout(() => { finished = true; reject(new CognitiveStorageError('Unavailable', 'زمان انتظار آرشیو پایان یافت؛ محدودیت ذخیره‌سازی مرورگر را بررسی کنید.')); }, 5000);
+      const stop = (error: unknown) => { clearTimeout(timer); finished = true; reject(storageFailure(error)); };
+      request.onupgradeneeded = () => {
+        const store = request.result.createObjectStore(COGNITIVE_ARCHIVE_STORE, { keyPath: 'recordId' });
+        for (const key of ['userProfileId', 'releasedScenarioId', 'recordedAtIso']) store.createIndex(key, key);
+        store.createIndex('ownerScenarioOrder', ['userProfileId', 'releasedScenarioId', 'recordedAtIso', 'recordId']);
+      };
+      request.onerror = () => stop(request.error);
+      request.onblocked = () => stop(new CognitiveStorageError('Blocked', 'آرشیو توسط صفحه دیگری مسدود شده است؛ صفحه‌های قدیمی را ببندید.'));
+      request.onsuccess = () => {
+        clearTimeout(timer);
+        if (finished) { request.result.close(); return; }
+        request.result.onversionchange = () => request.result.close();
+        resolve(request.result);
+      };
+    } catch (error) { reject(storageFailure(error)); }
+  });
+}
+
+async function transaction<T>(mode: IDBTransactionMode, work: (store: IDBObjectStore, result: (v: T) => void, abort: (error: unknown) => void) => void): Promise<T> {
+  const db = await openArchive();
+  try {
+    return await new Promise<T>((resolve, reject) => {
+      let value: T;
+      let failure: unknown;
+      const tx = db.transaction(COGNITIVE_ARCHIVE_STORE, mode);
+      tx.oncomplete = () => resolve(value);
+      tx.onabort = () => reject(storageFailure(failure ?? tx.error));
+      tx.onerror = () => { failure ??= tx.error; };
+      const abort = (error: unknown) => { failure = error; tx.abort(); };
+      try { work(tx.objectStore(COGNITIVE_ARCHIVE_STORE), v => { value = v; }, abort); }
+      catch (error) { abort(error); }
+    });
+  } catch (error) { throw storageFailure(error); }
+  finally { db.close(); }
+}
+
+export type CognitiveInsertResult = { status: 'saved' | 'already-saved'; recordId: string } | { status: 'disabled' };
+
+// Used by the real completion adapter only; this low-level store is not a provenance/security boundary.
+export async function insertCompletedCognitiveRunIfAbsent(input: SavedCognitiveRunV1): Promise<CognitiveInsertResult> {
+  const policy = readCognitiveArchivePolicy();
+  if (policy.error) throw new CognitiveStorageError('PolicyUnavailable', policy.error);
+  if (!policy.enabled) return { status: 'disabled' };
+  const record = structuredClone(input);
+  validateSavedCognitiveRun(record);
+  requireExistingCognitiveOwner(record.userProfileId);
+  return transaction('readwrite', (store, done, abort) => {
+    const get = store.get(record.recordId);
+    get.onsuccess = () => {
+      try {
+        // Re-read after asynchronous DB opening and immediately before mutation.
+        const currentPolicy = readCognitiveArchivePolicy();
+        if (currentPolicy.error) throw new CognitiveStorageError('PolicyUnavailable', currentPolicy.error);
+        if (!currentPolicy.enabled) { done({ status: 'disabled' }); return; }
+        requireExistingCognitiveOwner(record.userProfileId);
+        if (get.result !== undefined) {
+          validateSavedCognitiveRun(get.result);
+          const { recordedAtIso: oldTime, ...old } = get.result;
+          const { recordedAtIso: newTime, ...next } = record;
+          void oldTime; void newTime;
+          if (JSON.stringify(old) !== JSON.stringify(next)) throw new CognitiveStorageError('IdentityConflict', 'شناسه تلاش با گزارش دیگری تعارض دارد؛ بازنویسی انجام نشد.');
+          done({ status: 'already-saved', recordId: record.recordId });
+        } else {
+          const add = store.add({ ...record, recordedAtIso: new Date().toISOString() });
+          add.onsuccess = () => done({ status: 'saved', recordId: record.recordId });
+        }
+      } catch (error) { abort(error); }
+    };
+  });
+}
+
+function requireReadAccess(profileId: string, currentProfileId: string): void {
+  requireExistingCognitiveOwner(profileId);
+  if (profileId !== currentProfileId) throw new CognitiveStorageError('OwnerMismatch', 'گزارش متعلق به پروفایل انتخاب‌شده نیست.');
+}
+
+export async function listCognitiveRuns(profileId: string, scenarioId: 4 | 5, currentProfileId: string): Promise<SavedCognitiveRunV1[]> {
+  requireReadAccess(profileId, currentProfileId);
+  if (scenarioId !== 4 && scenarioId !== 5) throw new CognitiveStorageError('ScenarioMismatch', 'سناریوی آرشیو نامعتبر است.');
+  return transaction('readonly', (store, done, abort) => {
+    const get = store.index('userProfileId').getAll(profileId);
+    get.onsuccess = () => {
+      try {
+        requireReadAccess(profileId, currentProfileId);
+        const rows: SavedCognitiveRunV1[] = [];
+        for (const value of get.result) {
+          validateSavedCognitiveRun(value);
+          if (value.userProfileId !== profileId) throw new CognitiveStorageError('OwnerMismatch', 'مالک رکورد نامعتبر است.');
+          if (value.releasedScenarioId === scenarioId) rows.push(value);
+        }
+        rows.sort((a, b) => b.recordedAtIso.localeCompare(a.recordedAtIso) || b.recordId.localeCompare(a.recordId));
+        done(rows);
+      } catch (error) { abort(error); }
+    };
+  });
+}
+
+export async function readCognitiveRun(recordId: string, currentProfileId: string): Promise<SavedCognitiveRunV1 | null> {
+  requireExistingCognitiveOwner(currentProfileId);
+  return transaction('readonly', (store, done, abort) => {
+    const get = store.get(recordId);
+    get.onsuccess = () => {
+      try {
+        if (get.result === undefined) { done(null); return; }
+        validateSavedCognitiveRun(get.result);
+        requireReadAccess(get.result.userProfileId, currentProfileId);
+        done(get.result);
+      } catch (error) { abort(error); }
+    };
+  });
+}
diff --git a/src/services/storage/completedCognitiveAttempt.ts b/src/services/storage/completedCognitiveAttempt.ts
--- /dev/null
+++ b/src/services/storage/completedCognitiveAttempt.ts
@@ -0,0 +1,43 @@
+import type { CognitiveModelV3Result } from '../../ui/components/scenario/scenario-four/model/cognitiveEngineV3';
+import type { ScenarioOneFinalSnapshot } from '../../ui/components/scenario/scenario-four/model/types';
+import type { Scenario5RuntimeResult, Scenario5RuntimeState } from '../../ui/components/scenario/scenario-five/model/runtime/types';
+import { insertCompletedCognitiveRunIfAbsent, requireExistingCognitiveOwner } from './cognitiveRunRepository';
+import { S1_STAMPS, S2_STAMPS, type SavedCognitiveRunV1 } from './cognitiveRunValidation';
+
+// Identity is separate from scientific runId; object identity rejects rehydrated fixtures.
+export interface CognitiveAttempt { readonly recordId: string; readonly userProfileId: string; readonly releasedScenarioId: 4 | 5; readonly sourceRunId: string }
+const liveAttempts = new WeakSet<CognitiveAttempt>();
+export function beginCognitiveAttempt(userProfileId: string | undefined, scenarioId: string | number, sourceRunId: string): CognitiveAttempt {
+  if (!userProfileId) throw new Error('شناسه پروفایل آغازکننده موجود نیست؛ آرشیو انجام نمی‌شود.');
+  requireExistingCognitiveOwner(userProfileId);
+  const releasedScenarioId = scenarioId === 4 || scenarioId === 's4_redesigned_scenario_one' ? 4 : scenarioId === 5 || scenarioId === 's5_silent_waves_redesign' ? 5 : null;
+  if (!releasedScenarioId || !sourceRunId || /preview|fixture|demo|dummy|test.only|design.sample/i.test(sourceRunId)) throw new Error('مسیر واقعی اجرای سناریوی منتشرشده معتبر نیست.');
+  const attempt = Object.freeze({ recordId: crypto.randomUUID(), userProfileId, releasedScenarioId, sourceRunId });
+  liveAttempts.add(attempt);
+  return attempt;
+}
+function base(attempt: CognitiveAttempt | null) {
+  if (!attempt || !liveAttempts.has(attempt)) throw new Error('هویت تلاش آغازشده در دسترس نیست؛ گزارش ذخیره نشد.');
+  requireExistingCognitiveOwner(attempt.userProfileId);
+  return { schemaVersion: 'cross-scenario-run-v1' as const, ...attempt, recordedAtIso: new Date().toISOString(), source: 'new-completion-v1' as const };
+}
+export function archiveS1Completion(attempt: CognitiveAttempt | null, snapshot: ScenarioOneFinalSnapshot, cognitive: CognitiveModelV3Result) {
+  const record = base(attempt);
+  if (record.releasedScenarioId !== 4 || snapshot.scenarioId !== 's4_redesigned_scenario_one' || snapshot.runId !== record.sourceRunId || !snapshot.completedAt || snapshot.cognitiveScoresV3 !== (cognitive as unknown) || !snapshot.move1 || !snapshot.move2 || !snapshot.move3) {
+    throw new Error('گزارش تکمیل‌شده سناریوی ۱ با تلاش آغازشده تطابق ندارد.');
+  }
+  return insertCompletedCognitiveRunIfAbsent({ ...record, releasedScenarioId: 4, internalScenarioId: 's4_redesigned_scenario_one', cognitive, modelStamps: { ...S1_STAMPS } });
+}
+export function archiveS2Completion(attempt: CognitiveAttempt | null, runtime: Scenario5RuntimeState, result: Scenario5RuntimeResult) {
+  const record = base(attempt);
+  if (record.releasedScenarioId !== 5 || runtime.stage.stageId !== 'complete' || runtime.runId !== record.sourceRunId || runtime.runId !== result.runId || result.runId !== result.cognitive.runId) throw new Error('گزارش تکمیل‌شده سناریوی ۲ با تلاش آغازشده تطابق ندارد.');
+  const saved: SavedCognitiveRunV1 = { ...record, releasedScenarioId: 5, internalScenarioId: 's5_silent_waves_redesign', cognitive: result.cognitive, modelStamps: { ...S2_STAMPS } };
+  return insertCompletedCognitiveRunIfAbsent(saved);
+}
+
+export async function completionArchiveStatus(action: () => ReturnType<typeof archiveS2Completion>): Promise<string> {
+  try {
+    const result = await action();
+    return result.status === 'disabled' ? 'ذخیره گزارش شناختی غیرفعال است؛ گزارش جدیدی آرشیو نشد.' : 'گزارش شناختی این اجرا برای پروفایل آغازکننده در این مرورگر ذخیره شد.';
+  } catch (error) { return `گزارش شناختی ذخیره نشد: ${error instanceof Error ? error.message : String(error)}`; }
+}
