@@ -0,0 +1,59 @@
+import type { EvidenceInstance } from "../index";
+import type { CognitiveWindowId, EvidenceTelemetry, Scenario5CognitiveTelemetryBundle } from "../cognitive/index";
+import type { Scenario5MissionState } from "../mission/index";
+import type { RuntimeRoundId, Scenario5RuntimeState } from "./types";
+
+const WINDOWS_AFTER_RELEASE: Readonly<Record<RuntimeRoundId, readonly CognitiveWindowId[]>> = {
+  1: ["A2_evidence_acquisition", "B1_monitoring_allocation", "B2_route_policy", "C1_support_and_checkpoints", "C2_resource_portfolio", "D1_crisis_response", "D2_final_delivery_policy"],
+  2: ["B1_monitoring_allocation", "B2_route_policy", "C1_support_and_checkpoints", "C2_resource_portfolio", "D1_crisis_response", "D2_final_delivery_policy"],
+  3: ["B2_route_policy", "C1_support_and_checkpoints", "C2_resource_portfolio", "D1_crisis_response", "D2_final_delivery_policy"],
+  4: ["C1_support_and_checkpoints", "C2_resource_portfolio", "D1_crisis_response", "D2_final_delivery_policy"],
+  5: ["C2_resource_portfolio", "D1_crisis_response", "D2_final_delivery_policy"],
+  6: ["D1_crisis_response", "D2_final_delivery_policy"],
+  7: ["D2_final_delivery_policy"],
+  8: [],
+};
+
+const adaptEvidence = (
+  item: EvidenceInstance,
+  releasedAfterRound: RuntimeRoundId,
+  availableAtMs: number,
+): EvidenceTelemetry => ({
+  evidenceId: item.evidenceId,
+  sourceType: item.sourceType,
+  observedCorridorId: item.observedCorridorId,
+  direction: item.direction,
+  strengthBand: item.strengthBand,
+  relevantWindowIds: [...WINDOWS_AFTER_RELEASE[releasedAfterRound]],
+  availableAtMs,
+  qualityLabelVisible: item.qualityLabelVisible,
+  limitationVisible: item.limitationVisible,
+});
+
+export function adaptNewVisibleEvidence(
+  missionBefore: Scenario5MissionState,
+  missionAfter: Scenario5MissionState,
+  releasedAfterRound: RuntimeRoundId,
+  availableAtMs: number,
+): readonly EvidenceTelemetry[] {
+  const beforeIds = new Set(missionBefore.visibleEvidence.map(({ evidenceId }) => evidenceId));
+  return missionAfter.visibleEvidence
+    .filter(({ evidenceId }) => !beforeIds.has(evidenceId))
+    .map((item) => adaptEvidence(item, releasedAfterRound, availableAtMs));
+}
+
+export function buildScenario5CognitiveTelemetryBundle(
+  state: Scenario5RuntimeState,
+): Scenario5CognitiveTelemetryBundle {
+  return {
+    scenarioId: "s5_silent_waves_redesign",
+    runId: state.runId,
+    startedAtMs: state.startedAtMs,
+    completedAtMs: state.completedAtMs,
+    decisions: state.decisions,
+    evidence: state.evidence,
+    evidenceOpens: state.evidenceOpens,
+    beliefs: state.beliefs,
+    reasons: state.reasons,
+  };
+}
diff --git a/src/ui/components/scenario/scenario-five/model/runtime/types.ts b/src/ui/components/scenario/scenario-five/model/runtime/types.ts
new file mode 100644
index 0000000..b2e8259
--- /dev/null
+++ b/src/ui/components/scenario/scenario-five/model/runtime/types.ts
@@ -0,0 +1,265 @@
+import type { CorridorId, Scenario5Seed, WorldId } from "../index";
+import type {
+  BeliefTelemetry,
+  CognitiveWindowId,
+  DecisionTelemetry,
+  EvidenceOpenTelemetry,
+  EvidenceTelemetry,
+  ReasonId,
+  ReasonTelemetry,
+  Scenario5CognitiveRunResult,
+} from "../cognitive/index";
+import type {
+  MissionActionId,
+  MissionActionSelection,
+  MissionConvoyState,
+  MissionResourceState,
+  Scenario5EndState,
+  Scenario5MissionState,
+} from "../mission/index";
+
+export type RuntimeStageId =
+  | "decision:A1_baseline_monitoring"
+  | "belief:A2_prebelief"
+  | "decision:A2_evidence_acquisition"
+  | "belief:A2_postbelief"
+  | "decision:B1_monitoring_allocation"
+  | "decision:B2_route_policy"
+  | "reason:B"
+  | "decision:C1_support_and_checkpoints"
+  | "decision:C2_resource_portfolio"
+  | "reason:C"
+  | "belief:C_belief_checkpoint"
+  | "decision:D1_crisis_response"
+  | "belief:D_final_belief"
+  | "decision:D2_final_delivery_policy"
+  | "reason:D"
+  | "outcome_review"
+  | "complete";
+
+export type RuntimeRoundId = 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;
+export type RuntimePhaseId = "A" | "B" | "C" | "D";
+
+export interface Scenario5RuntimeConfig {
+  readonly runId: string;
+  readonly worldId: WorldId;
+  readonly seed: Scenario5Seed;
+  readonly startedAtMs: number;
+}
+
+export interface RuntimeStageState {
+  readonly stageId: RuntimeStageId;
+  readonly enteredAtMs: number;
+  readonly nextStageId?: RuntimeStageId;
+}
+
+export interface RuntimeSelectionRecord {
+  readonly actionId: MissionActionId;
+  readonly selectedAtMs: number;
+}
+
+export interface RuntimeActiveEvidenceOpen {
+  readonly evidenceId: string;
+  readonly windowId: CognitiveWindowId;
+  readonly openedAtMs: number;
+}
+
+export interface PendingRuntimeDecision {
+  readonly selection: MissionActionSelection;
+  readonly phaseId: RuntimePhaseId;
+  readonly roundId: RuntimeRoundId;
+  readonly windowId: CognitiveWindowId;
+  readonly availableActionIds: readonly MissionActionId[];
+  readonly selectionHistory: readonly RuntimeSelectionRecord[];
+  readonly enteredAtMs: number;
+  readonly confirmedAtMs: number;
+  readonly elapsedMs: number;
+  readonly activeDecisionMs: number;
+  readonly hiddenTabMs: number;
+  readonly revisionCount: number;
+  readonly availableEvidenceIds: readonly string[];
+  readonly openedEvidenceIds: readonly string[];
+  readonly playerVisibleResourcesBefore: {
+    readonly isrCapacity: number;
+    readonly supportReserve: number;
+  };
+}
+
+export interface Scenario5DomainDecisionRecord {
+  readonly roundId: RuntimeRoundId;
+  readonly windowId: CognitiveWindowId;
+  readonly actionId: MissionActionId;
+  readonly effectiveTargetCorridorId: CorridorId | null;
+  readonly worldClockBefore: number;
+  readonly worldClockAfter: number;
+  readonly resourcesBefore: MissionResourceState;
+  readonly resourcesAfter: MissionResourceState;
+  readonly convoyStateBefore: readonly MissionConvoyState[];
+  readonly convoyStateAfter: readonly MissionConvoyState[];
+  readonly actorDelayImpactByCorridor: Readonly<Record<CorridorId, number>>;
+  readonly newVisibleEvidenceIds: readonly string[];
+}
+
+export type Scenario5RuntimeEventKind =
+  | "runtime_created"
+  | "runtime_stage_entered"
+  | "runtime_action_selected"
+  | "runtime_evidence_opened"
+  | "runtime_evidence_closed"
+  | "runtime_decision_confirmed"
+  | "runtime_reason_recorded"
+  | "runtime_belief_recorded"
+  | "runtime_mission_step_committed"
+  | "runtime_outcome_continued"
+  | "runtime_completed";
+
+export interface Scenario5RuntimeEvent {
+  readonly eventId: string;
+  readonly sequence: number;
+  readonly eventKind: Scenario5RuntimeEventKind;
+  readonly atMs: number;
+  readonly stageId: RuntimeStageId;
+  readonly payload: Readonly<Record<string, unknown>>;
+}
+
+export interface Scenario5RuntimeState {
+  readonly runtimeModelVersion: string;
+  readonly domainMetricsVersion: string;
+  readonly runId: string;
